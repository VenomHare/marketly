# Local development credentials for compose.yaml only. Replace these outside local development.
MONGODB_USERNAME=marketly
MONGODB_PASSWORD=marketly_mongo_dev_password
MONGODB_URI=mongodb://marketly:marketly_mongo_dev_password@localhost:27017/marketly?authSource=admin&replicaSet=rs0
JWT_SECRET=
API_BASE_URL=http://localhost:3000/api/v1


REDIS_PASSWORD=marketly_redis_dev_password
REDIS_URL=redis://:marketly_redis_dev_password@localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=marketly_elastic_dev_password

# Choose one provider below. The bucket name is required for either provider.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=

# AWS S3 configuration (used when OBJECT_STORAGE_PROVIDER=s3).
# Leave S3_ENDPOINT and credentials blank to use AWS defaults/IAM role.
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloudflare R2 configuration (alternative to AWS S3):
# 1. Set OBJECT_STORAGE_PROVIDER=r2
# 2. Set R2_ACCOUNT_ID and the R2 bucket name above
# 3. Set S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY to your R2 API credentials
# 4. Leave S3_ENDPOINT blank to use https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# 5. Leave S3_REGION blank to use R2's required "auto" region
R2_ACCOUNT_ID=
