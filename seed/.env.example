# Local development values only. Replace these outside local development.
MONGODB_USERNAME=marketly
MONGODB_PASSWORD=marketly_mongo_dev_password
MONGODB_URI=mongodb://marketly:marketly_mongo_dev_password@localhost:27017/marketly?authSource=admin&replicaSet=rs0
JWT_SECRET=marketly-local-development-secret-change-before-sharing
BANK_DETAILS_ENCRYPTION_KEY=

REDIS_PASSWORD=marketly_redis_dev_password
REDIS_URL=redis://:marketly_redis_dev_password@localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=marketly_elastic_dev_password

# Configure these to upload placeholder images to local or production storage.
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_BUCKET=
R2_ACCOUNT_ID=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set SEED_ALLOW_RESET=true only when intentionally replacing the database.
SEED_ALLOW_RESET=false
